rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Users collection
    match /users/{userId} {
      // Allow reading user profiles for login, referral verification & profile views
      allow read: if true;

      // Allow creating and updating user profiles during registration & account usage
      allow create, update: if true;

      // Only allow delete for authorized maintenance
      allow delete: if request.auth != null;

      // Sub-collection: Referrals
      match /referrals/{referralId} {
        allow read, write: if true;
      }

      // Sub-collection: Transactions Ledger
      match /transactions/{transactionId} {
        allow read, write: if true;
      }
    }

    // 2. Top-level Payout Requests
    match /payoutRequests/{payoutId} {
      allow read, write: if true;
    }

    // 3. Sharded Counters (High concurrency metrics)
    match /shardedCounters/{counterId}/shards/{shardId} {
      allow read, write: if true;
    }

    // 4. Leaderboard Cache
    match /leaderboard/{period} {
      allow read, write: if true;
    }

    // 5. Packages collection
    match /packages/{packageId} {
      allow read, write: if true;
    }

    // 6. Test and system collections
    match /test/{docId} {
      allow read, write: if true;
    }

    // Default Allow for all application collections
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

